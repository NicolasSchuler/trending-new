def _bootstrap_into_venv() -> None:
    """Re-run the script with the bundled `.venv` interpreter when dependencies are missing.

    The executable is typically invoked through a symlink on `PATH` (e.g.
    `~/.local/bin/trending-new`) whose `#!/usr/bin/env python3` shebang can resolve to a
    system Python without this project's dependencies. When that happens, re-run the real
    script with the virtualenv's Python so the tool works regardless of how it was launched.

    Only `requests` is probed. The function returns without doing anything when it is
    importable, when the resolved script has no `.venv/bin/python` beside it, or when the
    current interpreter already runs from that virtualenv, which prevents an endless re-exec
    loop. Otherwise `os.execv` replaces the current process and the call never returns.
    """
    import importlib.util

    if importlib.util.find_spec("requests") is not None:
        return

    script = Path(__file__).resolve()
    venv_python = script.parent / ".venv" / "bin" / "python"
    if not venv_python.exists():
        return

    # Compare prefixes, not interpreters: the venv's python is a symlink to a
    # base interpreter that does not have the dependencies installed.
    if Path(sys.prefix).resolve() == (script.parent / ".venv").resolve():
        return

    os.execv(str(venv_python), [str(venv_python), str(script), *sys.argv[1:]])


_bootstrap_into_venv()

