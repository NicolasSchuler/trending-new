RANGES = ("daily", "weekly", "monthly")
DEFAULT_TIMEOUT_SECONDS = 20
USER_AGENT = "trending-new/1.2"
FETCH_ATTEMPTS = 3
RETRY_BACKOFF_SECONDS = 1
MAX_RETRY_DELAY_SECONDS = 30
RANGE_LABELS = {"daily": "day", "weekly": "week", "monthly": "month"}
RANGE_SHORT_LABELS = {"daily": "day", "weekly": "wk", "monthly": "mo"}


@dataclass(frozen=True)
class Entry:
    identifier: str
    url: str
    description: str
    language: str | None = None
    stars: int | None = None
    gained_stars: int | None = None
    trending_range: str | None = None
    popular_repo: str | None = None


def state_path() -> Path:
    configured_home = os.environ.get("XDG_DATA_HOME")
    data_home = Path(configured_home) if configured_home else None
    if data_home is None or not data_home.is_absolute():
        data_home = Path.home() / ".local" / "share"
    return data_home / "trending-new" / "state.sqlite3"


@contextmanager
def immediate_transaction(database: sqlite3.Connection) -> Iterator[None]:
    database.execute("BEGIN IMMEDIATE")
    try:
        yield
    except BaseException:
        database.rollback()
        raise
    else:
        database.commit()


def connect_database() -> sqlite3.Connection:
    path = state_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    database = sqlite3.connect(path)
    try:
        with immediate_transaction(database):
            database.execute("""
                CREATE TABLE IF NOT EXISTS seen (
                    kind TEXT NOT NULL,
                    identifier TEXT NOT NULL,
                    first_seen_at TEXT NOT NULL,
                    last_seen_at TEXT NOT NULL,
                    url TEXT NOT NULL,
                    description TEXT NOT NULL,
                    language TEXT,
                    stars INTEGER,
                    gained_stars INTEGER,
                    trending_range TEXT,
                    PRIMARY KEY (kind, identifier)
                )
            """)

            existing_columns = {
                row[1] for row in database.execute("PRAGMA table_info(seen)")
            }
            for column, column_type in (
                ("language", "TEXT"),
                ("stars", "INTEGER"),
                ("gained_stars", "INTEGER"),
                ("trending_range", "TEXT"),
                ("popular_repo", "TEXT"),
            ):
                if column not in existing_columns:
                    database.execute(f"ALTER TABLE seen ADD COLUMN {column} {column_type}")
    except BaseException:
        database.close()
        raise
    return database


def make_console() -> Console:
    plain_output = not sys.stdout.isatty() or "NO_COLOR" in os.environ
    return Console(
        no_color=plain_output,
        color_system=None if plain_output else "auto",
        force_terminal=False if plain_output else None,
        highlight=False,
    )


def retry_delay(attempt: int, response: requests.Response | None) -> float:
    delay = RETRY_BACKOFF_SECONDS * 2 ** (attempt - 1)
    retry_after = response.headers.get("Retry-After", "").strip() if response is not None else ""
    if retry_after.isdigit():
        delay = int(retry_after)
    return min(delay, MAX_RETRY_DELAY_SECONDS)


def fetch_page(
    url: str, params: dict[str, str], *, sleep: Callable[[float], None] = time.sleep
) -> BeautifulSoup:
    for attempt in range(1, FETCH_ATTEMPTS + 1):
        try:
            response = requests.get(
                url,
                params=params,
                headers={"User-Agent": USER_AGENT},
                timeout=DEFAULT_TIMEOUT_SECONDS,
            )
            response.raise_for_status()
            return BeautifulSoup(response.text, "html.parser")
        except requests.RequestException as error:
            failed_response = error.response
            status = failed_response.status_code if failed_response is not None else None
            transient = (
                isinstance(error, (requests.ConnectionError, requests.Timeout))
                or status == 429
                or (status is not None and status >= 500)
            )
            if not transient or attempt == FETCH_ATTEMPTS:
                raise SystemExit(f"Could not fetch GitHub Trending: {error}") from error
            delay = retry_delay(attempt, failed_response)
            reason = f"HTTP {status}" if status is not None else type(error).__name__
            print(
                f"GitHub Trending request failed ({reason}); retrying in {delay:g}s "
                f"(attempt {attempt + 1} of {FETCH_ATTEMPTS})...",
                file=sys.stderr,
            )
            sleep(delay)
    raise AssertionError("unreachable")


def clean_text(node: object | None) -> str:
    return node.get_text(" ", strip=True) if node else ""


def parse_count(text: str) -> int | None:
    match = re.search(r"\d[\d,]*", text)
    return int(match.group().replace(",", "")) if match else None


def fetch_repositories(
    time_range: str, language: str | None, spoken_language: str | None = None
) -> list[Entry]:
    url = "https://github.com/trending"
    if language:
        url += "/" + quote(language, safe="")
    params = {"since": time_range}
    if spoken_language:
        params["spoken_language_code"] = spoken_language
    document = fetch_page(url, params)

    entries: list[Entry] = []
    for row in document.select("article.Box-row"):
        link = row.select_one("h2 a[href]")
        if not link:
            continue
        identifier = link["href"].strip("/")
        if identifier.count("/") != 1:
            continue

        language_node = row.select_one('[itemprop="programmingLanguage"]')
        star_node = row.select_one('a[href$="/stargazers"]')
        gain_node = row.select_one("span.float-sm-right")
        entries.append(
            Entry(
                identifier=identifier,
                url=f"https://github.com/{identifier}",
                description=clean_text(row.select_one("p")),
                language=clean_text(language_node) or None,
                stars=parse_count(clean_text(star_node)),
                gained_stars=parse_count(clean_text(gain_node)),
                trending_range=time_range,
            )
        )

    if not entries:
        page_text = clean_text(document).casefold()
        if "have any trending repositories for your choices" in page_text:
            return []
        raise SystemExit("GitHub returned no repositories; its page structure may have changed.")
    return entries


def fetch_developers(time_range: str) -> list[Entry]:
    document = fetch_page("https://github.com/trending/developers", {"since": time_range})

    entries: list[Entry] = []
    for row in document.select("article.Box-row"):
        link = row.select_one("h1.h3 a[href]")
        if not link:
            continue
        identifier = link["href"].strip("/")
        if not identifier or "/" in identifier:
            continue
        popular_link = row.select_one("article h1.h4 a[href]")
        popular_repo = popular_link["href"].strip("/") if popular_link else ""
        entries.append(
            Entry(
                identifier,
                f"https://github.com/{identifier}",
                clean_text(row.select_one("p")),
                popular_repo=popular_repo if popular_repo.count("/") == 1 else None,
            )
        )

    if not entries:
        raise SystemExit("GitHub returned no developers; its page structure may have changed.")
    return entries


def unseen_entries(database: sqlite3.Connection, kind: str, entries: Iterable[Entry]) -> list[Entry]:
    unseen: list[Entry] = []
    checked_identifiers: set[str] = set()
    for entry in entries:
        if entry.identifier in checked_identifiers:
            continue
        checked_identifiers.add(entry.identifier)
        if not database.execute(
            "SELECT 1 FROM seen WHERE kind = ? AND identifier = ?",
            (kind, entry.identifier),
        ).fetchone():
            unseen.append(entry)
    return unseen


def record_seen(database: sqlite3.Connection, kind: str, entries: Iterable[Entry]) -> None:
    timestamp = datetime.now(timezone.utc).isoformat()
    database.executemany(
        """
        INSERT INTO seen(
            kind, identifier, first_seen_at, last_seen_at, url, description,
            language, stars, gained_stars, trending_range, popular_repo
        ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
        ON CONFLICT(kind, identifier) DO UPDATE SET
            last_seen_at = excluded.last_seen_at,
            url = excluded.url,
            description = excluded.description,
            language = excluded.language,
            stars = excluded.stars,
            gained_stars = excluded.gained_stars,
            trending_range = excluded.trending_range,
            popular_repo = excluded.popular_repo
        """,
        [
            (
                kind,
                entry.identifier,
                timestamp,
                timestamp,
                entry.url,
                entry.description,
                entry.language,
                entry.stars,
                entry.gained_stars,
                entry.trending_range,
                entry.popular_repo,
            )
            for entry in entries
        ],
    )


def process_unseen_entries(
    database: sqlite3.Connection,
    kind: str,
    entries: Iterable[Entry],
    display: Callable[[list[Entry]], None],
    *,
    record: bool = True,
) -> list[Entry]:
    if not record:
        new_entries = unseen_entries(database, kind, entries)
        if new_entries:
            display(new_entries)
        return new_entries

    with immediate_transaction(database):
        new_entries = unseen_entries(database, kind, entries)
        if new_entries:
            display(new_entries)
            record_seen(database, kind, new_entries)
    return new_entries


def format_count(value: int | None) -> str:
    if value is None:
        return "—"
    if value < 1_000:
        return f"{value:,}"
    for divisor, suffix in ((1_000_000_000, "b"), (1_000_000, "m"), (1_000, "k")):
        if value >= divisor:
            compact = f"{value / divisor:.1f}".rstrip("0").rstrip(".")
            return f"{compact}{suffix}"
    return str(value)


def trend_label(entry: Entry, *, show_range: bool) -> str:
    if entry.gained_stars is None:
        return "—"
    suffix = RANGE_SHORT_LABELS.get(entry.trending_range or "", "")
    return f"+{format_count(entry.gained_stars)}" + (f" / {suffix}" if show_range and suffix else "")


def repository_cell(entry: Entry, include_description: bool) -> Text:
    cell = Text()
    cell.append(entry.identifier, style=f"bold cyan link {entry.url}")
    if include_description and entry.description:
        cell.append("\n")
        cell.append(entry.description, style="dim")
    return cell


def new_table() -> Table:
    return Table(
        box=box.SIMPLE_HEAVY,
        border_style="dim",
        header_style="bold cyan",
        pad_edge=False,
        collapse_padding=True,
        show_lines=False,
    )


def repository_table(
    entries: list[Entry], console: Console, *, show_range: bool, start_index: int = 1
) -> Table:
    width = console.width
    table = new_table()
    use_emoji = console.is_terminal and not console.no_color
    stars_header = "⭐ STARS" if use_emoji else "STARS"
    trend_header = (
        "TREND WHEN FOUND" if show_range and width >= 110 else ("TREND" if show_range else "GAIN")
    )
    if use_emoji:
        trend_header = f"🔥 {trend_header}"

    if width >= 110:
        table.add_column("#", justify="right", width=3)
        table.add_column("REPOSITORY", min_width=22, max_width=34, no_wrap=True, overflow="ellipsis")
        table.add_column("LANGUAGE", min_width=9, max_width=13, no_wrap=True, overflow="ellipsis")
        table.add_column(stars_header, justify="right", width=8)
        table.add_column(trend_header, justify="right", min_width=9, max_width=19)
        table.add_column("DESCRIPTION", ratio=1, overflow="fold")
        for index, entry in enumerate(entries, start=start_index):
            table.add_row(
                str(index),
                repository_cell(entry, False),
                entry.language or "—",
                format_count(entry.stars),
                Text(trend_label(entry, show_range=show_range), style="bold green"),
                Text(entry.description or "—", style="dim"),
            )
        return table

    if width >= 80:
        table.add_column("#", justify="right", width=3)
        table.add_column("REPOSITORY", ratio=1, min_width=26)
        table.add_column("LANGUAGE", min_width=8, max_width=12, no_wrap=True, overflow="ellipsis")
        table.add_column(stars_header, justify="right", width=8 if use_emoji else 7)
        table.add_column(trend_header, justify="right", min_width=8, max_width=15)
        for index, entry in enumerate(entries, start=start_index):
            table.add_row(
                str(index),
                repository_cell(entry, True),
                entry.language or "—",
                format_count(entry.stars),
                Text(trend_label(entry, show_range=show_range), style="bold green"),
            )
        return table

    table.add_column("#", justify="right", width=3)
    table.add_column("REPOSITORY", ratio=1, min_width=20)
    table.add_column("SIGNAL", justify="right", min_width=13, max_width=22)
    for index, entry in enumerate(entries, start=start_index):
        signal = f"{entry.language or '—'} · {format_count(entry.stars)} · {trend_label(entry, show_range=show_range)}"
        table.add_row(str(index), repository_cell(entry, True), Text(signal, style="green"))
    return table


def developer_table(entries: list[Entry], *, start_index: int = 1) -> Table:
    table = new_table()
    table.add_column("#", justify="right", width=3)
    table.add_column("DEVELOPER", min_width=20)
    table.add_column("POPULAR REPO", min_width=20)
    table.add_column("PROFILE NAME", ratio=1)
    for index, entry in enumerate(entries, start=start_index):
        popular_repo = (
            Text(entry.popular_repo, style=f"cyan link https://github.com/{entry.popular_repo}")
            if entry.popular_repo
            else Text("—")
        )
        table.add_row(
            str(index),
            Text(entry.identifier, style=f"bold cyan link {entry.url}"),
            popular_repo,
            entry.description or "—",
        )
    return table


def print_entries(
    entries: list[Entry],
    console: Console,
    *,
    kind: str,
    time_range: str | None,
    language: str | None,
    history: bool,
    show_range: bool,
    start_index: int = 1,
    spoken_language: str | None = None,
) -> None:
    if history:
        title = f"Previously shown GitHub Trending {'developers' if kind == 'developer' else 'repositories'}"
        subtitle = (
            f"{len(entries)} recorded locally · stars and gains as first shown"
            " · --open to revisit"
        )
    elif kind == "repository":
        source_language = language or "all languages"
        title = f"GitHub Trending · {time_range.title()} · {source_language}"
        if spoken_language:
            title += f" · spoken language {spoken_language}"
        subtitle = f"{len(entries)} new repositories · total stars and gain this {RANGE_LABELS[time_range]}"
    else:
        title = f"GitHub Trending Developers · {time_range.title()}"
        subtitle = f"{len(entries)} new developers"

    console.print(Text(title, style="bold"))
    console.print(Text(subtitle, style="dim"))
    console.print(
        repository_table(entries, console, show_range=show_range, start_index=start_index)
        if kind == "repository"
        else developer_table(entries, start_index=start_index)
    )


def picker_label(entry: Entry, index: int, *, show_range: bool, kind: str = "repository") -> str:
    if kind == "developer":
        return (
            f"{index:>2}  {entry.identifier:<24.24}  {(entry.popular_repo or '—'):<40.40}  "
            f"{entry.description}"
        )
    if entry.language or entry.stars is not None or entry.gained_stars is not None:
        return (
            f"{index:>2}  {entry.identifier:<34.34}  {(entry.language or '—'):<12.12} "
            f"{format_count(entry.stars):>8}  {trend_label(entry, show_range=show_range):>12}  {entry.description}"
        )
    return f"{index:>2}  {entry.identifier:<34.34}  {entry.description}"


def select_entries(
    entries: list[Entry], *, show_range: bool, kind: str = "repository"
) -> list[Entry]:
    if not sys.stdin.isatty():
        raise SystemExit("--open needs an interactive terminal.")

    if shutil.which("fzf"):
        choices = [
            f"{entry.identifier}\t{picker_label(entry, index, show_range=show_range, kind=kind)}"
            for index, entry in enumerate(entries, start=1)
        ]
        result = subprocess.run(
            [
                "fzf",
                "--multi",
                "--delimiter=\\t",
                "--with-nth=2..",
                "--prompt=Open on GitHub> ",
                "--header=Type to filter · Tab to mark · Enter to open",
            ],
            input="\n".join(choices),
            text=True,
            capture_output=True,
            check=False,
        )
        if result.returncode not in (0, 1):
            raise SystemExit(f"fzf failed with status {result.returncode}.")
        selected_identifiers = {line.split("\t", 1)[0] for line in result.stdout.splitlines()}
        return [entry for entry in entries if entry.identifier in selected_identifiers]

    print("Enter row numbers separated by commas, 'a' for all, or press Enter to cancel.")
    answer = input("Open> ").strip().lower()
    if answer == "a":
        return entries
    try:
        indices = {int(value.strip()) for value in answer.split(",") if value.strip()}
    except ValueError as error:
        raise SystemExit("Please enter comma-separated row numbers.") from error
    return [entry for index, entry in enumerate(entries, start=1) if index in indices]


def open_entries(entries: list[Entry]) -> None:
    for entry in entries:
        print(f"Opening {entry.url}")
        webbrowser.open_new_tab(entry.url)


def normalize_language(value: str | None) -> str | None:
    return value.casefold().replace(" ", "-") if value else None


def contains_text(haystack: str | None, needle: str) -> bool:
    return needle in (haystack or "").casefold()


def show_history(
    database: sqlite3.Connection,
    kind: str,
    limit: int,
    languages: list[str] | None = None,
    search: str | None = None,
) -> list[Entry]:
    database.create_function("normalize_language", 1, normalize_language, deterministic=True)
    database.create_function("contains_text", 2, contains_text, deterministic=True)

    conditions = ["kind = ?"]
    parameters: list[object] = [kind]
    if languages:
        normalized = {normalize_language(language) for language in languages}
        conditions.append(f"normalize_language(language) IN ({', '.join('?' * len(normalized))})")
        parameters.extend(normalized)
    if search:
        conditions.append("(contains_text(identifier, ?) OR contains_text(description, ?))")
        parameters.extend([search.casefold()] * 2)
    rows = database.execute(
        f"""
        SELECT identifier, url, description, language, stars, gained_stars,
               trending_range, popular_repo
        FROM seen WHERE {" AND ".join(conditions)}
        ORDER BY first_seen_at DESC
        LIMIT ?
        """,
        (*parameters, limit),
    ).fetchall()
    return [Entry(*row) for row in rows]


def forget_entries(database: sqlite3.Connection, kind: str, identifiers: list[str]) -> None:
    removed: list[str] = []
    missing: list[str] = []
    with immediate_transaction(database):
        for identifier in dict.fromkeys(value.strip().strip("/") for value in identifiers):
            deleted = database.execute(
                "DELETE FROM seen WHERE kind = ? AND identifier = ? COLLATE NOCASE",
                (kind, identifier),
            ).rowcount
            (removed if deleted else missing).append(identifier)

    if removed:
        noun = "entry" if len(removed) == 1 else "entries"
        print(f"Forgot {len(removed)} {kind} {noun}: {', '.join(removed)}")
    if missing:
        print(f"Not found in {kind} history: {', '.join(missing)}", file=sys.stderr)
        raise SystemExit(1)


def print_json(entries: list[Entry], kind: str) -> None:
    records = [
        {"kind": kind, **asdict(entry), "description": entry.description or None}
        for entry in entries
    ]
    print(json.dumps(records, ensure_ascii=False, indent=2))


def parse_arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Show GitHub Trending repositories or developers not displayed before."
    )
    parser.add_argument(
        "command",
        nargs="?",
        default="all",
        choices=("all", *RANGES, "history", "forget"),
        help="all time ranges (default), one time range, history, or forget to un-record entries",
    )
    parser.add_argument(
        "identifiers",
        nargs="*",
        metavar="IDENTIFIER",
        help="forget only: owner/repo (or developer login with --developers) to show again",
    )
    parser.add_argument(
        "--language",
        action="append",
        help="repository language, e.g. python or rust; repeat to combine (history: filter)",
    )
    parser.add_argument(
        "--spoken-language",
        metavar="CODE",
        help="spoken language of repository descriptions, e.g. en or zh",
    )
    parser.add_argument("--developers", action="store_true", help="track Trending Developers instead")
    parser.add_argument("--open", action="store_true", help="interactively select entries to open")
    parser.add_argument(
        "--peek", action="store_true", help="show unseen entries without recording them as seen"
    )
    parser.add_argument("--json", action="store_true", help="print a JSON array instead of a table")
    parser.add_argument("--search", help="history only: text in the identifier or description")
    parser.add_argument("--limit", type=int, default=50, help="maximum history entries (default: 50)")
    return parser.parse_intermixed_args()


def validate_arguments(arguments: argparse.Namespace) -> None:
    command = arguments.command
    if arguments.limit < 1:
        raise SystemExit("--limit must be positive.")
    if command == "forget":
        if not arguments.identifiers:
            raise SystemExit("forget needs at least one identifier, e.g. owner/repo.")
        for option, used in (
            ("--open", arguments.open),
            ("--json", arguments.json),
            ("--peek", arguments.peek),
            ("--language", arguments.language),
            ("--spoken-language", arguments.spoken_language),
            ("--search", arguments.search),
        ):
            if used:
                raise SystemExit(f"{option} cannot be used with forget.")
    elif arguments.identifiers:
        raise SystemExit("Identifiers are only accepted by the forget command.")
    if arguments.json and arguments.open:
        raise SystemExit("--json cannot be combined with --open.")
    if arguments.search and command != "history":
        raise SystemExit("--search can only be used with history.")
    if command == "history":
        if arguments.peek:
            raise SystemExit("--peek cannot be used with history.")
        if arguments.spoken_language:
            raise SystemExit("--spoken-language cannot be used with history.")
    if arguments.developers:
        if arguments.spoken_language:
            raise SystemExit("--spoken-language cannot be used with --developers.")
        if arguments.language:
            raise SystemExit("--language cannot be used with --developers.")


def main() -> None:
    arguments = parse_arguments()
    validate_arguments(arguments)

    kind = "developer" if arguments.developers else "repository"
    console = make_console()
    database = connect_database()
    try:
        if arguments.command == "forget":
            forget_entries(database, kind, arguments.identifiers)
            return

        if arguments.command == "history":
            entries = show_history(
                database, kind, arguments.limit, arguments.language, arguments.search
            )
            if arguments.json:
                print_json(entries, kind)
                return
            if not entries:
                filtered = arguments.language or arguments.search
                print(
                    f"No {kind} entries match the filters."
                    if filtered
                    else f"No {kind} entries have been recorded yet."
                )
                return
            print_entries(
                entries,
                console,
                kind=kind,
                time_range=None,
                language=None,
                history=True,
                show_range=True,
            )
        else:
            entries = []
            shown_identifiers: set[str] = set()
            ranges = RANGES if arguments.command == "all" else (arguments.command,)
            languages = list(dict.fromkeys(arguments.language or [None]))
            for time_range in ranges:
                for language in languages:
                    fetched_entries = (
                        fetch_developers(time_range)
                        if arguments.developers
                        else fetch_repositories(
                            time_range, language, spoken_language=arguments.spoken_language
                        )
                    )
                    # Peeking records nothing, so repeat appearances are filtered in memory.
                    fetched_entries = [
                        entry
                        for entry in fetched_entries
                        if entry.identifier not in shown_identifiers
                    ]

                    def display(
                        new_entries: list[Entry], time_range: str = time_range, language: str | None = language
                    ) -> None:
                        if arguments.json:
                            return
                        if entries:
                            console.print()
                        print_entries(
                            new_entries,
                            console,
                            kind=kind,
                            time_range=time_range,
                            language=language,
                            history=False,
                            show_range=arguments.command == "all",
                            start_index=len(entries) + 1,
                            spoken_language=arguments.spoken_language,
                        )

                    new_entries = process_unseen_entries(
                        database, kind, fetched_entries, display, record=not arguments.peek
                    )
                    entries.extend(new_entries)
                    shown_identifiers.update(entry.identifier for entry in new_entries)

            if arguments.json:
                print_json(entries, kind)
                return
            if not entries:
                print(f"No unseen trending {kind} entries.")
                return

        if arguments.open:
            open_entries(
                select_entries(
                    entries, show_range=arguments.command in ("all", "history"), kind=kind
                )
            )
    finally:
        database.close()


if __name__ == "__main__":
    main()
